# ---------------------------------------------------------------------------
# Production build only (`vite build`). Development is untouched: `npm run dev`
# never loads this file, so it still issues same-origin /api/v1 requests that
# the dev-server proxy forwards to the local backend.
#
# This is the deployed backend's public address, not a secret. A Vercel
# dashboard variable of the same name overrides it.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://tracex-6457.onrender.com/api/v1
