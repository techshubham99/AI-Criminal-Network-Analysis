# ---------------------------------------------------------------------------
# TRACEX frontend environment. Copy to `.env.local` and edit.
#
# The API address is configurable, not compiled in. Nothing in the shipped
# bundle assumes localhost: `src/api/client.ts` reads VITE_API_BASE_URL and
# falls back to a same-origin relative path, so the same build runs against a
# dev proxy or a deployed API depending only on this file.
# ---------------------------------------------------------------------------

# ------------------------------------------------------- backend API base --
# The deployed API base, including the version prefix. Set this for any build
# served from an origin that has no proxy in front of it. The backend must
# allow this origin in CORS.
#
#   VITE_API_BASE_URL=https://your-api-domain.example/api/v1
#
# Leave it UNSET for local development: the API layer then issues same-origin
# relative requests (/api/v1/...) that the Vite proxy below forwards, so the
# browser never needs CORS. The SSE stream and /health follow this same base.
# VITE_API_BASE_URL=

# Where the Vite DEV-SERVER proxy forwards /api and /health. Development only —
# this value is not part of a production build.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Base URL used by `npm run test:live` when talking to a real backend.
VITE_LIVE_API_URL=http://127.0.0.1:8000

# --------------------------------------------------- optional AI connector --
# Core intelligence — NLP extraction, graph analytics, pattern detection,
# priority scoring — runs entirely in this project's own backend pipeline. No
# third-party AI service is required, and with the connector disabled every
# feature works in full.
#
# This flag is a backend setting (prefix CNA_), read where an external LLM
# adapter would be registered. It is off by default and there is no provider
# implementation in this repository.
# CNA_AI_PROVIDER_ENABLED=false

# ---------------------------------------------------------------------------
# NOT INTEGRATED. There is no connection to NCRB, CCTNS/ICJS, telecom CDR
# systems or any banking network. The corpus is synthetic. Any such integration
# would require its own authorised adapter and is not present here.
# ---------------------------------------------------------------------------
