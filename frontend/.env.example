# ---------------------------------------------------------------------------
# Frontend environment — local only. There are no external services, no API
# keys, and no third-party endpoints anywhere in this application.
# Copy to `.env.local` and edit if your backend is not on port 8000.
# ---------------------------------------------------------------------------

# Where the Vite dev-server proxy forwards /api and /health.
# This is the ONLY place the backend's address is configured.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional. Leave UNSET for normal development: the API layer then issues
# same-origin relative requests (/api/v1/...) that the proxy above forwards,
# so the browser never needs CORS. Set it to an absolute base URL only when
# serving the built bundle from somewhere that has no proxy in front of it,
# e.g. VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# VITE_API_BASE_URL=

# Base URL used by `npm run test:live` when talking to a real backend.
VITE_LIVE_API_URL=http://127.0.0.1:8000
